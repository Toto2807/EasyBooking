# Copier ce fichier en ".env" puis adapter si besoin (l'application lit les variables d'environnement).
# Les valeurs par défaut du code fonctionnent déjà avec docker-compose.yml.

DATABASE_URL=postgresql+psycopg://easybooking:easybooking@localhost:5433/easybooking
SECRET_KEY=change-me-with-a-long-random-string-of-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Base utilisée uniquement par les tests (le nom DOIT finir par _test, elle est vidée à chaque run)
TEST_DATABASE_URL=postgresql+psycopg://easybooking:easybooking@localhost:5433/easybooking_test
